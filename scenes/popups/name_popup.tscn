[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/popups/name_popup.gd" id="1_name"]

[node name="NamePopup" type="PanelContainer"]
custom_minimum_size = Vector2(420, 0)
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"MapPopup"
script = ExtResource("1_name")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="TitleLabel" type="Label" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "Name your new ship"

[node name="NameRow" type="HBoxContainer" parent="Content"]
layout_mode = 2

[node name="NameEdit" type="LineEdit" parent="Content/NameRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Ship name"

[node name="RandomButton" type="Button" parent="Content/NameRow"]
unique_name_in_owner = true
layout_mode = 2
text = "Random"

[node name="PortRow" type="HBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="PortLabel" type="Label" parent="Content/PortRow"]
layout_mode = 2
theme_type_variation = &"DimLabel"
text = "Launch at"

[node name="PortOption" type="OptionButton" parent="Content/PortRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
size_flags_horizontal = 3

[node name="ErrorLabel" type="Label" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"ErrorLabel"
autowrap_mode = 3

[node name="Buttons" type="HBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="CancelButton" type="Button" parent="Content/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
size_flags_horizontal = 3
text = "Cancel"

[node name="BuyButton" type="Button" parent="Content/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
size_flags_horizontal = 3
text = "Buy"
