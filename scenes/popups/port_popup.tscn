[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/popups/port_popup.gd" id="1_port"]

[node name="PortPopup" type="PanelContainer"]
custom_minimum_size = Vector2(260, 0)
offset_right = 260.0
offset_bottom = 120.0
theme_type_variation = &"MapPopup"
script = ExtResource("1_port")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Header" type="HBoxContainer" parent="Content"]
layout_mode = 2

[node name="TitleLabel" type="Label" parent="Content/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"HeaderLabel"
text = "Port"

[node name="CloseButton" type="Button" parent="Content/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
text = "X"
flat = true

[node name="Separator" type="HSeparator" parent="Content"]
layout_mode = 2

[node name="DockedLabel" type="Label" parent="Content"]
layout_mode = 2
text = "Your ships docked here:"

[node name="ShipList" type="VBoxContainer" parent="Content"]
unique_name_in_owner = true
layout_mode = 2

[node name="NoShipsLabel" type="Label" parent="Content"]
unique_name_in_owner = true
modulate = Color(1, 1, 1, 0.6)
layout_mode = 2
text = "None"

[node name="Separator2" type="HSeparator" parent="Content"]
layout_mode = 2

[node name="MarketLabel" type="Label" parent="Content"]
modulate = Color(1, 1, 1, 0.6)
layout_mode = 2
text = "Cargo market: coming soon"
