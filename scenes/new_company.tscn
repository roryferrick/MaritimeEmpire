[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/new_company.gd" id="1_company"]

[node name="NewCompany" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_company")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.08, 0.2, 0.36, 1)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Card" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(460, 0)
layout_mode = 2
theme_type_variation = &"CardPanel"

[node name="Content" type="VBoxContainer" parent="Center/Card"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Center/Card/Content"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "Found your company"

[node name="NameLabel" type="Label" parent="Center/Card/Content"]
layout_mode = 2
theme_type_variation = &"DimLabel"
text = "Company name"

[node name="NameEdit" type="LineEdit" parent="Center/Card/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
placeholder_text = "e.g. Blue Horizon Shipping"

[node name="PortLabel" type="Label" parent="Center/Card/Content"]
layout_mode = 2
theme_type_variation = &"DimLabel"
text = "Home port (new ships are delivered here)"

[node name="PortPicker" type="OptionButton" parent="Center/Card/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2

[node name="StartNote" type="Label" parent="Center/Card/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
theme_type_variation = &"DimLabel"
text = "Great start"
autowrap_mode = 3

[node name="ColorLabel" type="Label" parent="Center/Card/Content"]
layout_mode = 2
theme_type_variation = &"DimLabel"
text = "Company color (your name and the rings around your hubs)"

[node name="ColorRow" type="GridContainer" parent="Center/Card/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8
columns = 6

[node name="SpeedRow" type="HBoxContainer" parent="Center/Card/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="SpeedLabel" type="Label" parent="Center/Card/Content/SpeedRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"DimLabel"
tooltip_text = "The most this company's game can be sped up."
mouse_filter = 1
text = "Fastest game speed"

[node name="StormRow" type="HBoxContainer" parent="Center/Card/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="StormLabel" type="Label" parent="Center/Card/Content/StormRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"DimLabel"
tooltip_text = "Storms form in their real seasons and seas. From company level 6 they slow ships, wear them, and the strongest close ports while they pass."
mouse_filter = 1
text = "Storms"

[node name="ToggleRow" type="HBoxContainer" parent="Center/Card/Content"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="TutorialToggle" type="CheckButton" parent="Center/Card/Content/ToggleRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Recommended for new players: tips that explain the basics as you play, one at a time. You can switch them off later from the map; if you leave this off, the game won't offer them."
button_pressed = true
text = "Tutorial"

[node name="SeasonsToggle" type="CheckButton" parent="Center/Card/Content/ToggleRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Real seasonal closures: the Great Lakes locks shut in winter, Antarctica opens only in its summer, and icebound ports freeze."
button_pressed = true
text = "Seasonal closures"

[node name="Spacer" type="Control" parent="Center/Card/Content"]
custom_minimum_size = Vector2(0, 2)
layout_mode = 2

[node name="Buttons" type="HBoxContainer" parent="Center/Card/Content"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="BackButton" type="Button" parent="Center/Card/Content/Buttons"]
