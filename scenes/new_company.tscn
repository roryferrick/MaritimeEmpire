[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/new_company.gd" id="1_company"]
[ext_resource type="Script" path="res://scripts/ui/map_view.gd" id="2_map"]

[node name="NewCompany" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_company")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.08, 0.2, 0.36, 1)

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 0

[node name="MapView" type="Control" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
script = ExtResource("2_map")

[node name="Side" type="CenterContainer" parent="Row"]
custom_minimum_size = Vector2(500, 0)
layout_mode = 2

[node name="Card" type="PanelContainer" parent="Row/Side"]
custom_minimum_size = Vector2(460, 0)
layout_mode = 2
theme_type_variation = &"CardPanel"

[node name="Content" type="VBoxContainer" parent="Row/Side/Card"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Title" type="Label" parent="Row/Side/Card/Content"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "Found your company"

[node name="NameLabel" type="Label" parent="Row/Side/Card/Content"]
layout_mode = 2
theme_type_variation = &"DimLabel"
theme_override_font_sizes/font_size = 16
text = "Company name"

[node name="NameEdit" type="LineEdit" parent="Row/Side/Card/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
placeholder_text = "e.g. Blue Horizon Shipping"

[node name="PortLabel" type="Label" parent="Row/Side/Card/Content"]
layout_mode = 2
theme_type_variation = &"DimLabel"
theme_override_font_sizes/font_size = 14
text = "Choose your headquarters: click a port on the map. Your company starts there and new ships are delivered there. Green is a good start (shining: excellent), yellow fair, red hard, blue the Great Lakes."
autowrap_mode = 3

[node name="PortName" type="Label" parent="Row/Side/Card/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Rome, Italy"

[node name="StartNote" type="Label" parent="Row/Side/Card/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 96)
layout_mode = 2
theme_type_variation = &"DimLabel"
theme_override_font_sizes/font_size = 15
text = "Great start"
autowrap_mode = 3
mouse_filter = 1
text_overrun_behavior = 3
max_lines_visible = 5

[node name="ColorLabel" type="Label" parent="Row/Side/Card/Content"]
layout_mode = 2
theme_type_variation = &"DimLabel"
theme_override_font_sizes/font_size = 14
text = "Company color (your name and the rings around your hubs)"

[node name="ColorRow" type="GridContainer" parent="Row/Side/Card/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8
columns = 9

[node name="SpeedRow" type="HBoxContainer" parent="Row/Side/Card/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="SpeedLabel" type="Label" parent="Row/Side/Card/Content/SpeedRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"DimLabel"
theme_override_font_sizes/font_size = 16
tooltip_text = "The most this company's game can be sped up."
mouse_filter = 1
text = "Fastest game speed"

[node name="StormRow" type="HBoxContainer" parent="Row/Side/Card/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="StormLabel" type="Label" parent="Row/Side/Card/Content/StormRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"DimLabel"
theme_override_font_sizes/font_size = 16
tooltip_text = "Storms form in their real seasons and seas. From company level 6 they slow ships, wear them, and the strongest close ports while they pass."
mouse_filter = 1
text = "Storms"

[node name="ToggleRow" type="HBoxContainer" parent="Row/Side/Card/Content"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="TutorialToggle" type="CheckButton" parent="Row/Side/Card/Content/ToggleRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Recommended for new players: tips that explain the basics as you play, one at a time. You can switch them off later from the map; if you leave this off, the game won't offer them."
button_pressed = true
text = "Tutorial"

[node name="SeasonsToggle" type="CheckButton" parent="Row/Side/Card/Content/ToggleRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Real seasonal closures: the Great Lakes locks shut in winter, Antarctica opens only in its summer, and icebound ports freeze."
button_pressed = true
text = "Seasonal closures"

[node name="DivineToggle" type="CheckButton" parent="Row/Side/Card/Content/ToggleRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Unrealistic and unfair, for fun: buy storms (up to the billion-dollar Wrath) to send at rivals, a plague of gulls, the Kraken, lightning on a rival's hub and more; birds following a ship speed it up (to half as fast again), a port's birds quicken its loading and better its prices, and other blessings and omens. Rivals get the powers too. Can't be changed later."
text = "Divine Actions"

[node name="Spacer" type="Control" parent="Row/Side/Card/Content"]
custom_minimum_size = Vector2(0, 2)
layout_mode = 2

[node name="Buttons" type="HBoxContainer" parent="Row/Side/Card/Content"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="BackButton" type="Button" parent="Row/Side/Card/Content/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
size_flags_horizontal = 3
text = "Back"

[node name="StartButton" type="Button" parent="Row/Side/Card/Content/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
size_flags_horizontal = 3
text = "Start"
